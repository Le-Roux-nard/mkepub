<?xml version="1.0" encoding="utf-8" standalone="no"?>
<package xmlns="http://www.idpf.org/2007/opf" xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:dcterms="http://purl.org/dc/terms/" version="3.0" xml:lang="en"
  unique-identifier="uuid">
  <metadata>
    <dc:identifier id="uuid">{{ uuid }}</dc:identifier>
    <dc:title>{{ title|escape }}</dc:title>
    <dc:language>{{ lang if lang else 'en' }}</dc:language>
    <dc:date>{{ published if published else date[:10] }}</dc:date>
    <meta property="dcterms:modified">{{ date }}</meta>
    {% if dcterms %}{%- for name, value in dcterms.items() %}
    <meta property="dcterms:{{ name }}">{{ value }}</meta>
    {%- endfor %}{% endif %}
    {%- for collection in collections %}
      <meta property="belongs-to-collection" id="{{ collection['id'] }}">{{ collection["name"] | escape | title }}</meta>
      <meta refines="#{{ collection['id'] }}" property="collection-type">{{ collection["type"]| escape}}</meta>
      {%- if collection["number"] %}
      <meta refines="#{{ collection['id'] }}" property="group-position">{{collection["number"]|escape}}</meta>
      {%- endif %}
    {%- endfor %}
    {%- for creator in creators %}
      <dc:creator id="creator-{{creator['name']|escape}}">{{ creator["name"]|escape }}</dc:creator>
      {%- if creator["role"] %}
      <meta refines="#creator-{{creator['name']|escape}}" property="role" scheme="marc:relators">{{creator['role']|escape}}</meta>
      {%- endif %}
    {%- endfor %}
    {%- for contributor in contributors %}
      <dc:contributor id="contributor-{{contributor['name']|escape}}">{{ contributor["name"]|escape }}</dc:contributor>
      {%- if contributor["role"] %}
      <meta refines="#contributor-{{contributor['name']|escape}}" property="role" scheme="marc:relators">{{contributor['role']|escape}}</meta>
      {%- endif %}
    {%- endfor %}
    {%- for subject in subjects %}
    <dc:subject>{{ subject|escape }}</dc:subject>
    {%- endfor %}
    {%- if description %}
    <dc:description>{{ description|escape }}</dc:description>
    {%- endif %}
    {%- if rights %}
    <dc:rights>{{ rights|escape }}</dc:rights>
    <meta name="cover" content="cover"/>
    {%- endif %}
  </metadata>
  <manifest>
    <item id="htmltoc" properties="nav" media-type="application/xhtml+xml" href="toc.xhtml"/>
    <item href="toc.ncx" id="toc" media-type="application/x-dtbncx+xml"/>
    {%- for stylesheet in stylesheets %}
    <item media-type="text/css" id="css-{{ stylesheet.stylesheet_id }}" href="{{ stylesheet.path }}"/>
    {%- endfor %}

    {%- if cover %}
    <item id="cover" properties="cover-image" href="{{ cover | format_path }}" media-type="{{ cover|mediatype }}"/>
      {%- if cover_as_first_page %}
      <item id="cover-xhtml" href="cover.xhtml" media-type="application/xhtml+xml"/>
      {%- endif %}
    {%- endif %}
    {%- for page in pages %}
    <item id="id-{{ page.page_id }}" href="{{ page.path }}" media-type="application/xhtml+xml"/>
    {%- endfor %}
    {% for image in images %}
    <item id="id-im{{ image.image_id }}" href="images/{{ image.name }}" media-type="{{ image.name|mediatype }}"/>
    {% endfor %}
    {%- for font in fonts %}
    <item id="id-{{ font }}" href="fonts/{{ font }}" media-type="{{ font|fonttype }}"/>
    {%- endfor %}
  </manifest>
  <spine toc="toc">
    {%- if cover and cover_as_first_page %}
    <itemref idref="cover-xhtml" linear="yes"/>
    {%- endif %}
    {%- if toc_visible %}
    <itemref idref="htmltoc"/>
    {%- endif %}
    {%- for page in pages %}
    <itemref idref="id-{{ page.page_id }}"/>
    {%- endfor %}
  </spine>
</package>
